<script>
// PARSER START
const AREAS = ["Athlone","Bellville","Brackenfell","Cape Town CBD","Century City","Claremont","Durbanville","Goodwood","Khayelitsha","Kuils River","Milnerton","Mitchells Plain","Mowbray","Muizenberg","Observatory","Paarl","Parow","Rondebosch","Salt River","Sea Point","Somerset West","Stellenbosch","Strand","Table View","Woodstock","Wynberg"];
const ROADS = ["N1","N2","N7","M5","R300","Voortrekker Rd","Main Rd","Durban Rd","Klipfontein Rd","Vanguard Dr","Koeberg Rd","Strand St","Settlers Way","Jan Smuts Dr","Old Paarl Rd"];
const AREA_ALIASES = [
  ["mitchells? plain|mitchells?", "Mitchells Plain"], ["kuils ?river|kuils", "Kuils River"],
  ["somerset west|somerset", "Somerset West"], ["table ?view", "Table View"], ["sea ?point", "Sea Point"],
  ["salt ?river", "Salt River"], ["century city|century", "Century City"], ["observatory|\\bobs\\b", "Observatory"],
  ["khayelitsha|khayelisha|kayelitsha", "Khayelitsha"], ["stellenbosch|stellies", "Stellenbosch"],
  ["bellville|belville|bell ville", "Bellville"], ["brackenfell|bracken fell", "Brackenfell"],
  ["durbanville|durban ville", "Durbanville"], ["muizenberg|muisenberg", "Muizenberg"],
  ["rondebosch|ronde bosch", "Rondebosch"], ["goodwood|good wood", "Goodwood"], ["woodstock|wood stock", "Woodstock"],
  ["milnerton|milner ton", "Milnerton"], ["athlone|athlon", "Athlone"], ["claremont|clare mont", "Claremont"],
  ["mowbray|mow bray", "Mowbray"], ["wynberg|wineberg|wine berg|wynburg", "Wynberg"], ["parow|parrow|pa row", "Parow"],
  ["paarl|pearl", "Paarl"], ["\\bstrand\\b", "Strand"],
  ["cape town cbd|\\bcbd\\b|town centre|town center|city centre|city center|\\bin town\\b|\\bfor town\\b|cape town", "Cape Town CBD"]
];
const ROAD_ALIASES = [
  ["\\bn ?1\\b|\\b(?:n|en) one\\b", "N1"], ["\\bn ?2\\b|\\b(?:n|en) two\\b|\\b(?:n|en) too\\b", "N2"],
  ["\\bn ?7\\b|\\b(?:n|en) seven\\b", "N7"], ["\\bm ?5\\b|\\b(?:m|em) five\\b", "M5"],
  ["\\br ?300\\b|\\br three hundred\\b", "R300"], ["voortrekker|four trekker|for trekker|fortrekker", "Voortrekker Rd"],
  ["main road|main rd", "Main Rd"], ["durban road", "Durban Rd"], ["klipfontein|klip fontein", "Klipfontein Rd"],
  ["vanguard", "Vanguard Dr"], ["koeberg|cool berg", "Koeberg Rd"], ["strand street", "Strand St"],
  ["settlers", "Settlers Way"], ["jan smuts|jan smut", "Jan Smuts Dr"], ["old paarl road|old pearl road", "Old Paarl Rd"]
];
const POLICE_RX = /\b(police|polis|roadblock|road block|block road|checkpoint|check point|saps|metro|cops?|traffic (?:cop|officer|police)|officers?|soldier|army)\b/;
const GOSLOW_RX = /\b(go ?slow|go-slow|traffic|jam|hold ?up|holdup|accident|crash|standstill|stand still|no dey move|e no dey move|stuck|congestion)\b/;
const YES_RX = /\b(yes|yeah|yah|yep|yup|ya|ja|sure|ok|okay|correct|na so|drop am|drop it|send|go ahead|do am|confirm|right)\b/;
const NO_RX = /\b(no|nope|cancel|wrong|comot|leave am|stop)\b/;
const ASK_RX = /\b(wetin dey|wetin happen|any wahala|what'?s happening|what is happening|read|update|how road|how the road|how traffic|tell me)\b/;

function norm(t) { return (" " + String(t || "").toLowerCase().replace(/[^a-z0-9' -]/g, " ").replace(/\s+/g, " ") + " "); }
function detectType(t) {
  t = norm(t);
  if (POLICE_RX.test(t)) return "police";
  if (GOSLOW_RX.test(t)) return "goslow";
  return null;
}
function detectRoad(t) {
  t = norm(t);
  for (const [rx, name] of ROAD_ALIASES) { const m = t.match(new RegExp(rx)); if (m) return { road: name, rest: t.replace(m[0], " ") }; }
  const lm = t.match(/\b(?:by|near|at|for|on|opposite|before|after)\s+(?:the\s+)?([a-z0-9' ]{2,40}?\b(?:road|street|drive|avenue|mall|garage|robot|robots|circle|bridge|station|shoprite|engen|shell|spar|pick n pay|checkers|taxi rank|rank|hospital|church|school))\b/);
  if (lm) return { road: lm[1].trim().replace(/\b\w/g, c => c.toUpperCase()), rest: t.replace(lm[0], " ") };
  return { road: "", rest: t };
}
function detectArea(t) {
  t = norm(t);
  for (const [rx, name] of AREA_ALIASES) if (new RegExp(rx).test(t)) return name;
  return null;
}
function parseReport(text) {
  const type = detectType(text);
  const { road, rest } = detectRoad(text);
  const area = detectArea(rest);
  return { type, road, area };
}
// PARSER END
</script>
<script>
(() => {
  const TTL = { police: 120 * 60e3, goslow: 60 * 60e3 };
  const $ = (id) => document.getElementById(id);
  const ls = { get(k) { try { return localStorage.getItem(k); } catch { return null; } }, set(k, v) { try { localStorage.setItem(k, v); } catch {} } };
  const DEVICE = ls.get("rg-device") || (() => { const id = "d" + Math.random().toString(36).slice(2) + Date.now().toString(36); ls.set("rg-device", id); return id; })();

  $("f-area").innerHTML = '<option value="">Choose area</option>' + AREAS.map(a => `<option>${a}</option>`).join("");
  $("roads").innerHTML = ROADS.map(r => `<option value="${r}"></option>`).join("");
  $("area-filter").innerHTML = '<option value="">All areas</option>' + AREAS.map(a => `<option>${a}</option>`).join("");
  $("area-filter").value = ls.get("rg-area") || "";

  const toast = (msg) => { const t = $("toast"); t.textContent = msg; t.hidden = false; clearTimeout(toast._t); toast._t = setTimeout(() => t.hidden = true, 2600); };
  const notice = (msg) => { $("notice").textContent = msg; $("notice").hidden = !msg; };

  /* ===== 2. Data: Supabase when configured, otherwise this phone only ===== */
  let reports = [];
  const listeners = [];
  const emit = () => listeners.forEach(f => f(reports));

  function makeLocalStore() {
    notice("Demo mode: reports stay on this phone only. Add your Supabase keys to share with everybody (see README).");
    const load = () => { try { return JSON.parse(localStorage.getItem("rg-local") || "[]"); } catch { return []; } };
    const save = (rows) => { try { localStorage.setItem("rg-local", JSON.stringify(rows.slice(0, 300))); } catch {} };
    return {
      async refresh() { reports = load(); emit(); },
      async add(r) { const rows = load(); rows.unshift({ id: "l" + Date.now(), ...r, createdAt: Date.now(), by: DEVICE, still: { [DEVICE]: Date.now() }, cleared: {} }); save(rows); await this.refresh(); },
      async confirm(id, kind) { const rows = load(); const r = rows.find(x => x.id === id); if (r) { r[kind] = r[kind] || {}; r[kind][DEVICE] = Date.now(); save(rows); } await this.refresh(); },
      start() { this.refresh(); }
    };
  }

  function makeSupabaseStore() {
    const sb = window.supabase.createClient(CONFIG.SUPABASE_URL, CONFIG.SUPABASE_ANON_KEY);
    return {
      async refresh() {
        const since = new Date(Date.now() - 6 * 3600e3).toISOString();
        const { data: reps, error } = await sb.from("reports").select("*").gte("created_at", since).order("created_at", { ascending: false }).limit(300);
        if (error) { $("live").textContent = "Network wahala. We go try again."; return; }
        const ids = reps.map(r => r.id);
        let cons = [];
        if (ids.length) { const res = await sb.from("confirmations").select("report_id,kind,device_id,created_at").in("report_id", ids); cons = res.data || []; }
        reports = reps.map(r => ({ id: r.id, type: r.type, area: r.area, road: r.road || "", dir: r.dir || "", note: r.note || "", by: r.device_id, createdAt: Date.parse(r.created_at), still: {}, cleared: {} }));
        const byId = Object.fromEntries(reports.map(r => [r.id, r]));
        for (const c of cons) { const r = byId[c.report_id]; if (!r) continue; const ms = Date.parse(c.created_at); r[c.kind][c.device_id] = Math.max(r[c.kind][c.device_id] || 0, ms); }
        $("live").innerHTML = "<i></i>Live";
        emit();
      },
      async add(r) {
        const { error } = await sb.from("reports").insert({ type: r.type, area: r.area, road: r.road, dir: r.dir, note: r.note, device_id: DEVICE });
        if (error) throw error;
        await this.refresh();
      },
      async confirm(id, kind) {
        const { error } = await sb.from("confirmations").insert({ report_id: id, kind, device_id: DEVICE });
        if (error) throw error;
        await this.refresh();
      },
      start() {
        this.refresh();
        let t; const soon = () => { clearTimeout(t); t = setTimeout(() => this.refresh(), 400); };
        sb.channel("road-gist")
          .on("postgres_changes", { event: "INSERT", schema: "public", table: "reports" }, soon)
          .on("postgres_changes", { event: "INSERT", schema: "public", table: "confirmations" }, soon)
          .subscribe();
        setInterval(() => this.refresh(), 60e3);
        document.addEventListener("visibilitychange", () => { if (!document.hidden) this.refresh(); });
      }
    };
  }

  const store = (CONFIG.SUPABASE_URL && CONFIG.SUPABASE_ANON_KEY && window.supabase) ? makeSupabaseStore() : makeLocalStore();

  /* ===== 3. Helpers ===== */
  function ago(ms) {
    const m = Math.floor((Date.now() - ms) / 60e3);
    if (m < 1) return "now now";
    if (m < 60) return `${m} min ago`;
    const h = Math.floor(m / 60);
    return h === 1 ? "1 hour ago" : `${h} hours ago`;
  }
  const keys = (o) => Object.keys(o || {});
  const lastSeen = (r) => Math.max(r.createdAt || 0, ...Object.values(r.still || {}));
  function isActive(r) {
    if (!TTL[r.type]) return false;
    const seen = lastSeen(r);
    if (Date.now() - seen > TTL[r.type]) return false;
    return Object.values(r.cleared || {}).filter(n => n > seen).length < 2;
  }
  const active = (area) => reports.filter(isActive).filter(r => !area || r.area === area).sort((a, b) => lastSeen(b) - lastSeen(a));
  const label = (t) => t === "police" ? "Police roadblock" : "Go-slow";

  /* ===== 4. Typed report form (for passengers) ===== */
  let formType = null;
  function openForm(type) {
    formType = type;
    $("form").hidden = false;
    $("form-title").textContent = label(type);
    $("form-dot").style.background = type === "police" ? "var(--police)" : "var(--slow)";
    if (!$("f-area").value && ls.get("rg-myarea")) $("f-area").value = ls.get("rg-myarea");
    $("f-road").focus();
  }
  $("btn-police").onclick = () => openForm("police");
  $("btn-goslow").onclick = () => openForm("goslow");
  $("f-cancel").onclick = () => { $("form").hidden = true; formType = null; };
  $("form").addEventListener("submit", async (e) => {
    e.preventDefault();
    const area = $("f-area").value, road = $("f-road").value.trim();
    if (!formType || !area || !road) { toast("Abeg choose area and write the road."); return; }
    $("f-submit").disabled = true;
    try {
      await store.add({ type: formType, area, road: road.slice(0, 80), dir: $("f-dir").value, note: $("f-note").value.trim().slice(0, 200) });
      ls.set("rg-myarea", area);
      $("form").reset(); $("form").hidden = true; formType = null;
      toast("You don drop am. Thank you!");
    } catch { toast("E no go. Check your network and try again."); }
    finally { $("f-submit").disabled = false; }
  });

  async function vote(id, kind) {
    const k = `rg-v-${id}-${kind}`, last = +(ls.get(k) || 0);
    if (Date.now() - last < 10 * 60e3) { toast("You don already mark am. Thank you!"); return; }
    try { await store.confirm(id, kind); ls.set(k, String(Date.now())); toast(kind === "still" ? "We don mark am say e still dey." : "We don mark am say e don clear."); }
    catch { toast("E no go. Try again."); }
  }

  /* ===== 5. Feed ===== */
  let filterType = "all";
  document.querySelectorAll(".chip").forEach(c => c.onclick = () => {
    filterType = c.dataset.f;
    document.querySelectorAll(".chip").forEach(x => x.setAttribute("aria-pressed", String(x === c)));
    render();
  });
  $("area-filter").onchange = () => { ls.set("rg-area", $("area-filter").value); render(); };

  function render() {
    const area = $("area-filter").value;
    const list = active(area).filter(r => filterType === "all" || r.type === filterType);
    const feed = $("feed"); feed.replaceChildren();
    if (!list.length) {
      const e = document.createElement("div"); e.className = "empty";
      e.innerHTML = "<b>Road free for now</b><span></span>";
      e.querySelector("span").textContent = area ? `Nobody don report anything for ${area}. If you see police or go-slow, tap and talk.` : "Nobody don report anything. If you see police or go-slow, tap the yellow button and talk am.";
      feed.append(e); return;
    }
    for (const r of list) {
      const card = document.createElement("article");
      card.className = "card " + r.type;
      const seen = lastSeen(r), confirmed = seen > r.createdAt + 60e3;
      card.innerHTML = `<div class="card-top"><span class="kind"></span><span class="when"></span></div>
        <h3 class="place"><span class="road"></span><small class="sub"></small></h3>
        <p class="note" hidden></p>
        <div class="votes"><button class="vote yes" type="button"></button><button class="vote no" type="button"></button><button class="vote ghost hear" type="button">Hear am</button></div>`;
      card.querySelector(".kind").textContent = label(r.type);
      card.querySelector(".when").textContent = ago(r.createdAt) + (confirmed ? ` · seen ${ago(seen)}` : "");
      card.querySelector(".road").textContent = r.road || "Road no clear";
      card.querySelector(".sub").textContent = [r.area, r.dir].filter(Boolean).join(" · ");
      if (r.note) { const n = card.querySelector(".note"); n.textContent = r.note; n.hidden = false; }
      const yes = card.querySelector(".yes"), no = card.querySelector(".no");
      yes.textContent = `E still dey (${keys(r.still).length})`; no.textContent = `E don clear (${keys(r.cleared).length})`;
      yes.setAttribute("aria-pressed", String(!!(r.still && r.still[DEVICE]))); no.setAttribute("aria-pressed", String(!!(r.cleared && r.cleared[DEVICE])));
      yes.onclick = () => vote(r.id, "still"); no.onclick = () => vote(r.id, "cleared");
      card.querySelector(".hear").onclick = () => say(alertLine(r));
      feed.append(card);
    }
  }
  listeners.push(render);
  setInterval(render, 30e3);

  /* ===== 6. Voice: speak and listen ===== */
  const SR = window.SpeechRecognition || window.webkitSpeechRecognition;
  let voices = [];
  const loadVoices = () => { try { voices = speechSynthesis.getVoices(); } catch {} };
  loadVoices(); try { speechSynthesis.onvoiceschanged = loadVoices; } catch {}

  function setTalk(state, title, sub) {
    $("mic").dataset.state = state;
    $("talk-title").textContent = title;
    if (sub !== undefined) $("talk-sub").textContent = sub;
  }

  function say(text) {
    return new Promise((resolve) => {
      if (!("speechSynthesis" in window)) { toast(text); return resolve(); }
      try {
        speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(text);
        const v = voices.find(v => /en-NG/i.test(v.lang)) || voices.find(v => /en-ZA/i.test(v.lang)) || voices.find(v => /en-GB/i.test(v.lang));
        if (v) u.voice = v;
        u.rate = 0.95;
        const prev = $("mic").dataset.state;
        setTalk("speaking", "Road Gist dey talk", text);
        let done = false; const fin = () => { if (done) return; done = true; resolve(); };
        u.onend = fin; u.onerror = fin;
        setTimeout(fin, 2500 + text.length * 90);
        speechSynthesis.speak(u);
      } catch { resolve(); }
    });
  }

  function listen(ms = 7000) {
    return new Promise((resolve) => {
      if (!SR) return resolve(null);
      let rec; try { rec = new SR(); } catch { return resolve(null); }
      rec.lang = "en-NG"; rec.interimResults = true; rec.maxAlternatives = 1; rec.continuous = false;
      let heard = "", done = false;
      const finish = (v) => { if (done) return; done = true; clearTimeout(timer); try { rec.abort(); } catch {} resolve(v); };
      rec.onresult = (e) => {
        heard = Array.from(e.results).map(r => r[0].transcript).join(" ");
        $("talk-sub").innerHTML = ""; const em = document.createElement("em"); em.textContent = "“" + heard + "”"; $("talk-sub").append(em);
        if (e.results[e.results.length - 1].isFinal) finish(heard);
      };
      rec.onerror = (e) => { if (e.error === "not-allowed" || e.error === "service-not-allowed") micBlocked = true; finish(heard || null); };
      rec.onend = () => finish(heard || null);
      const timer = setTimeout(() => finish(heard || null), ms);
      setTalk("listening", "I dey listen…", "Talk now");
      try { rec.start(); } catch { finish(null); }
    });
  }

  function alertLine(r) {
    const where = [r.road, r.area].filter(Boolean).join(", ");
    return r.type === "police"
      ? `Police roadblock dey for ${where}, ${ago(lastSeen(r))}. Make sure your papers complete, and drive jeje.`
      : `Go-slow dey for ${where}, ${ago(lastSeen(r))}. If you fit, find another road.`;
  }

  async function readOut(area) {
    const list = active(area).slice(0, 3);
    if (!list.length) { await say(area ? `Road free for ${area} for now. Nobody don report anything.` : "Road free for now. Nobody don report anything."); return; }
    const more = active(area).length - list.length;
    await say(`${list.length === 1 ? "One report" : list.length + " reports"}${area ? " for " + area : ""}.`);
    for (const r of list) await say(alertLine(r));
    if (more > 0) await say(`Plus ${more} more. Look the screen when you don park.`);
  }

  /* ===== 7. Voice flow: one tap, then talk ===== */
  let busy = false, micBlocked = false, wakeLock = null;
  async function keepScreenOn() {
    try { if ("wakeLock" in navigator && !wakeLock) { wakeLock = await navigator.wakeLock.request("screen"); wakeLock.addEventListener("release", () => wakeLock = null); } } catch {}
  }
  document.addEventListener("visibilitychange", () => { if (!document.hidden && wakeLock === null && busyOnce) keepScreenOn(); });
  let busyOnce = false;

  async function talk() {
    if (busy) { try { speechSynthesis.cancel(); } catch {} return; }
    if (!SR) {
      setTalk("idle", "Voice no work for this browser", "Open Road Gist for Chrome on Android, or Safari on iPhone.");
      toast("This browser no fit hear voice. Use Chrome or Safari.");
      return;
    }
    busy = true; busyOnce = true; keepScreenOn();
    try {
      let heard = await listen(8000);
      if (micBlocked) { await say("I no fit use your microphone. Allow microphone for this site, then try again."); return; }
      if (!heard) { await say("I no hear you. Tap again and talk."); return; }

      let { type, road, area } = parseReport(heard);
      if (!type && ASK_RX.test(norm(heard))) { await readOut(area || ""); return; }
      if (!type && area) { await readOut(area); return; }

      if (!type) {
        await say("Na police or go-slow?");
        const a = await listen(5000); type = a && detectType(a);
        if (!type) { await say("I no catch am. Tap again and talk."); return; }
      }
      if (!area) {
        await say("Which area?");
        const a = await listen(6000); area = a && detectArea(a);
        if (!road && a) road = detectRoad(a).road;
        if (!area) { await say("I no know that area. Tap again, or make passenger type am."); return; }
      }

      const summary = `${label(type)} for ${road ? road + ", " : ""}${area}`;
      await say(`You talk say ${summary}. Make I drop am? Talk yes or no.`);
      const yn = await listen(5000);
      const ans = norm(yn || "");
      if (yn && YES_RX.test(ans) && !/\bno\b/.test(ans)) {
        try {
          await store.add({ type, area, road, dir: "", note: "Reported by voice" });
          ls.set("rg-myarea", area);
          await say("I don drop am. Thank you. Drive safe.");
        } catch { await say("E no go. Network get wahala. Try again small time."); }
      } else if (yn && NO_RX.test(ans)) {
        await say("Okay, I no drop am.");
      } else {
        await say("I no hear yes, so I no drop am.");
      }
    } finally {
      busy = false;
      setTalk("idle", "Tap and talk", "Say \"Police dey Main Road for Wynberg\"");
    }
  }
  $("mic").addEventListener("click", talk);

  store.start();
})();
</script>
</body>
</html>
